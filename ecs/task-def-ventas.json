{
  "family": "task-def-ventas",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::341430609758:role/LabRole",
  "taskRoleArn": "arn:aws:iam::341430609758:role/LabRole",
  "containerDefinitions": [
    {
      "name": "api-ventas",
      "image": "341430609758.dkr.ecr.us-east-1.amazonaws.com/innovatech/api-ventas:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "name": "api-ventas-port"
        }
      ],
      "environment": [
        { "name": "DB_ENDPOINT", "value": "database-test.cyai06qrlbv8.us-east-1.rds.amazonaws.com" },
        { "name": "DB_PORT",     "value": "3306" },
        { "name": "DB_NAME",     "value": "innovatech" },
        { "name": "DB_USERNAME", "value": "admin" },
        { "name": "DB_PASSWORD", "value": "Passw0rd.," }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/innovatech",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "ventas"
        }
      },
      "essential": true
    }
  ]
}
